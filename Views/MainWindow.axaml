<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FTX1Control.ViewModels"
        xmlns:models="using:FTX1Control.Models"
        xmlns:views="using:FTX1Control.Views"
        xmlns:converters="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1156" d:DesignHeight="1010"
        x:Class="FTX1Control.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Topmost="{Binding IsAlwaysOnTop}"
        ExtendClientAreaToDecorationsHint="True"
        Width="1156" Height="1010" MinWidth="1000" MinHeight="1010" WindowStartupLocation="Manual"
        RequestedThemeVariant="Dark"
        Icon="/Assets/ftx1-radio.ico"
        Title="{DynamicResource WindowTitle}">

    <Window.WindowDecorationsTheme>
        <ControlTheme TargetType="WindowDrawnDecorations" BasedOn="{StaticResource {x:Type WindowDrawnDecorations}}">
            <Style Selector="^ /template/ Panel#PART_TitleTextPanel">
                <Setter Property="Margin" Value="24,0,0,0" />
            </Style>
        </ControlTheme>
    </Window.WindowDecorationsTheme>

    <Window.Background>
        <RadialGradientBrush Center="42%,0%" GradientOrigin="42%,0%" RadiusX="35%" RadiusY="30%">
            <GradientStop Color="#0C2337" Offset="0" />
            <GradientStop Color="#0B1E2D" Offset="0.35" />
            <GradientStop Color="#08131B" Offset="0.75" />
            <GradientStop Color="#070F14" Offset="1" />
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <StreamGeometry x:Key="VfoSignalWaves">M 5.5,5.3 C 1.8,9 1.8,15 5.5,18.7 M 8.5,8.5 C 6.7,10.4 6.7,13.6 8.5,15.5 M 15.5,8.5 C 17.3,10.4 17.3,13.6 15.5,15.5 M 18.5,5.3 C 22.2,9 22.2,15 18.5,18.7</StreamGeometry>
        <LinearGradientBrush x:Key="PanelBackground" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#1C2932" Offset="0" />
            <GradientStop Color="#111A20" Offset="0.55" />
            <GradientStop Color="#15232D" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PanelBorder" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#788D9B" Offset="0" />
            <GradientStop Color="#465A67" Offset="0.45" />
            <GradientStop Color="#283844" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PopupBorder" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#A2B8C6" Offset="0" />
            <GradientStop Color="#718493" Offset="0.45" />
            <GradientStop Color="#465B68" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonBackground" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#2A3943" Offset="0" />
            <GradientStop Color="#1B252D" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ActiveButtonBackground" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#00A5FA" Offset="0" />
            <GradientStop Color="#0067D4" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MainVfoBorder" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#455F1E" Offset="0" />
            <GradientStop Color="#455F1E" Offset="0.5" />
            <GradientStop Color="#BFF730" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SubVfoBorder" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#25515F" Offset="0" />
            <GradientStop Color="#25515F" Offset="0.5" />
            <GradientStop Color="#00DBF4" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TransmitVfoBorder" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#79221C" Offset="0" />
            <GradientStop Color="#79221C" Offset="0.5" />
            <GradientStop Color="#FA4C40" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="VfoBottomGlowMask" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#20000000" Offset="0" />
            <GradientStop Color="#D0000000" Offset="1" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="VfoCornerHorizontalMask" Center="15%,0%" GradientOrigin="15%,0%" RadiusX="65%" RadiusY="85%">
            <GradientStop Color="#FF000000" Offset="0" />
            <GradientStop Color="#F0000000" Offset="0.2" />
            <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="VfoCornerVerticalMask" Center="0%,15%" GradientOrigin="0%,15%" RadiusX="65%" RadiusY="85%">
            <GradientStop Color="#FF000000" Offset="0" />
            <GradientStop Color="#F0000000" Offset="0.2" />
            <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="MainVfoCornerGlow" Center="0%,0%" GradientOrigin="0%,0%" RadiusX="39%" RadiusY="48%">
            <GradientStop Color="#30B7FA24" Offset="0" />
            <GradientStop Color="#00B7FA24" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="SubVfoCornerGlow" Center="0%,0%" GradientOrigin="0%,0%" RadiusX="39%" RadiusY="48%">
            <GradientStop Color="#3000E6FF" Offset="0" />
            <GradientStop Color="#0000E6FF" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="TransmitVfoCornerGlow" Center="0%,0%" GradientOrigin="0%,0%" RadiusX="39%" RadiusY="48%">
            <GradientStop Color="#33FF5049" Offset="0" />
            <GradientStop Color="#00FF5049" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="VfoTopRightShade" Center="100%,0%" GradientOrigin="100%,0%" RadiusX="32%" RadiusY="38%">
            <GradientStop Color="#8010161B" Offset="0" />
            <GradientStop Color="#0010161B" Offset="1" />
        </RadialGradientBrush>
    </Window.Resources>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="Foreground" Value="#E9EFED" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#202D36" />
            <Setter Property="Foreground" Value="#F0F4F2" />
            <Setter Property="BorderBrush" Value="#52616E" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#202D36" />
            <Setter Property="Foreground" Value="#F0F4F2" />
            <Setter Property="BorderBrush" Value="#52616E" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="Button.connect">
            <Setter Property="Background" Value="{StaticResource ActiveButtonBackground}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#00A9F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.volume-mute">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.meter">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
            <Setter Property="Foreground" Value="#D5DEDA" />
            <Setter Property="BorderBrush" Value="#40515D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ToggleButton.meter:checked">
            <Setter Property="Background" Value="{StaticResource ActiveButtonBackground}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#00A9F5" />
        </Style>
        <Style Selector="ToggleButton.meter:pointerover">
            <Setter Property="BorderBrush" Value="#6B8393" />
        </Style>
        <Style Selector="Button.detector">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
            <Setter Property="Foreground" Value="#D5DEDA" />
            <Setter Property="BorderBrush" Value="#40515D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.detector.selected">
            <Setter Property="Background" Value="{StaticResource ActiveButtonBackground}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#00A9F5" />
        </Style>
        <Style Selector="Button.detector.rf-power">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,9" />
        </Style>
        <Style Selector="Button.detector.tune:not(:disabled)">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
            <Setter Property="Foreground" Value="#F0F4F2" />
            <Setter Property="BorderBrush" Value="#52616E" />
        </Style>
        <Style Selector="Button.connect:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#168FE3" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#55C7FF" />
        </Style>
        <Style Selector="Button.detector.tune:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B85000" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#F4A261" />
        </Style>
        <Style Selector="Button.pinned-frequency">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
            <Setter Property="Foreground" Value="#D5DEDA" />
            <Setter Property="BorderBrush" Value="#40515D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Height" Value="70" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.pinned-frequency.pin">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
            <Setter Property="Foreground" Value="#F0F4F2" />
            <Setter Property="BorderBrush" Value="#52616E" />
        </Style>
        <Style Selector="Button.pinned-frequency.pin /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.pinned-frequency-callsign">
            <Setter Property="Background" Value="#151D1E" />
            <Setter Property="Foreground" Value="#F0F4F2" />
            <Setter Property="BorderBrush" Value="#3B4948" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.pinned-frequency.selected, Button.detector.rf-power-selected">
            <Setter Property="Background" Value="{StaticResource ActiveButtonBackground}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#00A9F5" />
        </Style>
        <Style Selector="Button.pinned-frequency:pointerover">
            <Setter Property="BorderBrush" Value="#6B8393" />
        </Style>
        <Style Selector="Button.detector.selected:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, Button.pinned-frequency.pin:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#168FE3" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#55C7FF" />
        </Style>
        <Style Selector="ToggleButton.auto-scroll">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
            <Setter Property="Foreground" Value="#D5DEDA" />
            <Setter Property="BorderBrush" Value="#40515D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="ToggleButton.auto-scroll:checked">
            <Setter Property="Background" Value="{StaticResource ActiveButtonBackground}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#00A9F5" />
        </Style>
        <Style Selector="ToggleButton.auto-scroll:checked:not(:pointerover):not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.meter:checked:not(:pointerover):not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ActiveButtonBackground}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#00A9F5" />
        </Style>
        <Style Selector="Button.settings">
            <Setter Property="Background" Value="#202D36" />
            <Setter Property="Foreground" Value="#D5DEDA" />
            <Setter Property="BorderBrush" Value="#52616E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Height" Value="44" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ToggleButton.meter:checked:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.auto-scroll:checked:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, Button.pinned-frequency.selected:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, Button.detector.rf-power-selected:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#168FE3" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#55C7FF" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="FlyoutPresenter.settings-popup">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PopupBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="Border.panel, Border.vfo-frame, FlyoutPresenter.settings-popup /template/ Border#LayoutRoot">
            <Setter Property="BoxShadow" Value="0 3 6 0 #80000000, inset 0 1 1 0 #50B5C9D6, inset 0 -1 1 0 #8004090E" />
        </Style>
        <Style Selector="Border.transmit-status">
            <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundChecked}" />
        </Style>
        <Style Selector="Border.transmit-status.transmitting">
            <Setter Property="Background" Value="{Binding TransmitStatusBrush}" />
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Background" Value="#E53935" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Background" Value="#851B19" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.vfo-glow.transmitting">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.vfo-corner-glow">
            <Setter Property="RenderTransformOrigin" Value="0%,0%" />
            <Style.Animations>
                <Animation Duration="0:0:8" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="0.9" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.35" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.85" />
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.04" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.35" />
                        <Setter Property="Opacity" Value="0.85" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.vfo-corner-horizontal">
            <Setter Property="OpacityMask" Value="{StaticResource VfoCornerHorizontalMask}" />
            <Style.Animations>
                <Animation Duration="0:0:8" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.5" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.vfo-corner-vertical">
            <Setter Property="OpacityMask" Value="{StaticResource VfoCornerVerticalMask}" />
            <Style.Animations>
                <Animation Duration="0:0:8" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.5" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.vfo-top-right">
            <Setter Property="BorderBrush" Value="{StaticResource VfoTopRightShade}" />
            <Setter Property="BorderThickness" Value="0,1.5,1.5,0" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Border.vfo-transmit-overlay">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.vfo-transmit-overlay.transmitting">
            <Setter Property="IsVisible" Value="True" />
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.7" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="TextBlock.s-meter-scale">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#98A8A2" />
        </Style>
        <Style Selector="views|WaveBackground">
            <Style.Animations>
                <Animation Duration="0:0:7" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Phase" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Phase" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid ClipToBounds="True">
    <views:WaveBackground IsHitTestVisible="False" />
    <Border VerticalAlignment="Top"
            Height="{Binding $parent[Window].WindowDecorationMargin.Top}"
            Background="#0CFFFFFF" BorderBrush="#34434F" BorderThickness="0,0,0,1"
            ClipToBounds="True" WindowDecorationProperties.ElementRole="TitleBar">
        <Image Source="/Assets/ftx1-radio.ico" Width="16" Height="16" Margin="12,0,0,0"
               HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Border>
    <Grid RowDefinitions="*,Auto" Margin="{Binding $parent[Window].WindowDecorationMargin}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="22.5,24" RowSpacing="18">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center" Margin="0,0,0,6">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="44" Height="24" Margin="0,0,9,0">
                        <Grid Width="40" Height="22">
                            <Path Data="M0,19 L11,4 L16,4 L5,19 Z" Fill="#00C9F5" />
                            <Path Data="M11,19 L23,4 L28,4 L16,19 Z" Fill="#00A7E7" />
                            <Path Data="M23,19 L35,4 L40,4 L28,19 Z" Fill="#1477B5" />
                        </Grid>
                    </Viewbox>
                    <TextBlock FontSize="34" FontWeight="Bold" Foreground="#D7E1EE" VerticalAlignment="Center">
                        <Run Text="Yaesu" /><Run Text="&#x20;FTX-1" Foreground="#3DB5F0" />
                    </TextBlock>
                    <Border Width="1" Height="29" Background="#9AAABD" Margin="16,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource HeaderTitle}" FontSize="23" Foreground="#C8D4E3" VerticalAlignment="Center" />
                </StackPanel>
            </Viewbox>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Height="44" Background="#202D36" BorderBrush="#52616E" BorderThickness="1" CornerRadius="4" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding ConnectionIndicatorBrush}" />
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ComboBox Width="140" Height="44" SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}" VerticalAlignment="Center">
                    <ComboBoxItem AutomationProperties.Name="Polski">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="24" Height="14" RowDefinitions="*,*" VerticalAlignment="Center">
                                <Border Background="#FFFFFF" />
                                <Border Grid.Row="1" Background="#DC143C" />
                            </Grid>
                            <TextBlock Text="Polski" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem AutomationProperties.Name="English">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="24" Height="14" Background="#012169" ClipToBounds="True" VerticalAlignment="Center">
                                <Path Data="M0,0 L24,14 M24,0 L0,14" Stroke="#FFFFFF" StrokeThickness="3" />
                                <Path Data="M0,0 L24,14 M24,0 L0,14" Stroke="#C8102E" StrokeThickness="1" />
                                <Path Data="M12,0 L12,14 M0,7 L24,7" Stroke="#FFFFFF" StrokeThickness="4" />
                                <Path Data="M12,0 L12,14 M0,7 L24,7" Stroke="#C8102E" StrokeThickness="2" />
                            </Grid>
                            <TextBlock Text="English" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>
                <Button Classes="settings" AutomationProperties.Name="{DynamicResource SettingsButton}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Grid Width="24" Height="24">
                                <Path Data="M10,1 L14,1 L14.5,3.3 L16.5,4.1 L18.5,2.8 L21.2,5.5 L19.9,7.5 L20.7,9.5 L23,10 L23,14 L20.7,14.5 L19.9,16.5 L21.2,18.5 L18.5,21.2 L16.5,19.9 L14.5,20.7 L14,23 L10,23 L9.5,20.7 L7.5,19.9 L5.5,21.2 L2.8,18.5 L4.1,16.5 L3.3,14.5 L1,14 L1,10 L3.3,9.5 L4.1,7.5 L2.8,5.5 L5.5,2.8 L7.5,4.1 L9.5,3.3 Z"
                                      Stroke="#D5DEDA" StrokeThickness="1.5" StrokeJoin="Round" />
                                <Ellipse Width="7" Height="7" Stroke="#D5DEDA" StrokeThickness="1.5" />
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="{DynamicResource SettingsButton}" FontSize="13" FontWeight="Bold" Foreground="#D5DEDA" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="settings-popup">
                            <StackPanel Spacing="10" MaxWidth="320">
                                <CheckBox Content="{DynamicResource AlwaysOnTop}" IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}" />
                                <Border Height="1" Background="#40515D" />
                                <TextBlock Text="{DynamicResource CatLogFolder}" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource CatLogFolderUnset}" IsVisible="{Binding IsCatLogFolderUnset}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CatLogFolder}" IsVisible="{Binding HasCatLogFolder}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="detector" Content="{DynamicResource ChooseCatLogFolder}" Click="OnChooseCatLogFolder" />
                                    <Button Classes="detector" Content="{DynamicResource DisableCatLogFile}" IsEnabled="{Binding HasCatLogFolder}" Click="OnDisableCatLogFile" />
                                </StackPanel>
                                <TextBlock Text="{Binding CatLogFileError}" IsVisible="{Binding HasCatLogFileError}" Foreground="#E74C3C" TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <Border Grid.Column="2" Width="1" Height="29" Background="#9AAABD" Margin="11,0,9,0" VerticalAlignment="Center" />
            <Image Grid.Column="3" Source="/Assets/SQ8MSX_round_logo_QRZ.png" Width="96" Height="96" Stretch="Uniform" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="13.5">
            <Border Classes="panel" Padding="17,11,14,11">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid MinHeight="32">
                        <TextBlock Text="{DynamicResource ConnectionTitle}" FontSize="10" FontWeight="Bold" Foreground="#D7E1EC" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,150,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                        <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                            <TextBlock Text="{DynamicResource SerialPortLabel}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" />
                            <ComboBox ItemsSource="{Binding AvailableComPorts}" SelectedItem="{Binding SelectedComPort}" IsEnabled="{Binding CanSelectComPort}" DropDownOpened="OnComPortDropDownOpened" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ComPortOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Stretch">
                            <TextBlock Text="{DynamicResource BaudRateLabel}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" />
                            <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate}" IsEnabled="{Binding CanSelectBaudRate}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="connect" Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectionCommand}" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Classes="panel" Padding="17,11,14,11">
                <Grid RowDefinitions="Auto,Auto,56" RowSpacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{DynamicResource CatStatus}" FontSize="10" FontWeight="Bold" Foreground="#D7E1EC" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12" Foreground="{Binding StatusMessageBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ToggleButton Grid.Column="2" Classes="auto-scroll" IsChecked="{Binding IsCatLogAutoScroll}" Content="{Binding CatLogAutoScrollButtonText}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding CatLogFileError}" IsVisible="{Binding HasCatLogFileError}" FontSize="12" Foreground="#E74C3C" TextWrapping="Wrap" />
                    <Border Grid.Row="2" Margin="0,-1,0,0" BorderBrush="#465A67" BorderThickness="1" CornerRadius="6">
                        <ScrollViewer x:Name="CatLogScrollViewer" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <SelectableTextBlock x:Name="CatLogText" Margin="12,0" TextWrapping="NoWrap" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="11" LineHeight="14" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Classes="panel" Padding="21,18,18,18">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="{DynamicResource TransmitPowerTitle}" FontSize="13" FontWeight="Bold" Foreground="#D7E1EC" />
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower5Selected}" Margin="0,0,6,0" Content="5 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="5" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower10Selected}" Margin="0,0,6,0" Content="10 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="10" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower15Selected}" Margin="0,0,6,0" Content="15 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="15" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower20Selected}" Margin="0,0,6,0" Content="20 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="20" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower25Selected}" Margin="0,0,6,0" Content="25 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="25" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower30Selected}" Margin="0,0,6,0" Content="30 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="30" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower50Selected}" Margin="0,0,6,0" Content="50 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="50" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower100Selected}" Content="100 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="100" />
                    </StackPanel>
                    <Slider Grid.Column="1" Minimum="5" Maximum="{Binding MaximumRfPower}" Value="{Binding RfPowerSliderValue, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1"
                            IsEnabled="{Binding CanSetRfPower}" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            PointerReleased="OnRfPowerSliderPointerReleased" KeyUp="OnRfPowerSliderKeyUp" />
                    <TextBlock Grid.Column="2" Text="{Binding RfPowerReading}" FontSize="25" FontWeight="Bold" MinWidth="90" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Grid.Row="2" Text="{DynamicResource SettingsTitle}" FontSize="13" FontWeight="Bold" Foreground="#D7E1EC" Margin="0,8,0,0" />
                <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="32">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="D-LEVEL" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="detector" Content="◀" Command="{Binding DecreaseDLevelCommand}" IsEnabled="{Binding CanDecreaseDLevel}" ToolTip.Tip="{DynamicResource DecreaseDLevelTip}" />
                            <Button Classes="detector" Content="▶" Command="{Binding IncreaseDLevelCommand}" IsEnabled="{Binding CanIncreaseDLevel}" ToolTip.Tip="{DynamicResource IncreaseDLevelTip}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DLevelReading}" FontSize="14" FontWeight="Bold" MinWidth="75" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="NB" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="detector" Content="◀" Command="{Binding DecreaseNoiseBlankerLevelCommand}" IsEnabled="{Binding CanDecreaseNoiseBlankerLevel}" ToolTip.Tip="{DynamicResource DecreaseNbTip}" />
                            <Button Classes="detector" Content="▶" Command="{Binding IncreaseNoiseBlankerLevelCommand}" IsEnabled="{Binding CanIncreaseNoiseBlankerLevel}" ToolTip.Tip="{DynamicResource IncreaseNbTip}" />
                        </StackPanel>
                        <TextBlock Text="{Binding NoiseBlankerLevelReading}" FontSize="14" FontWeight="Bold" MinWidth="30" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="DNR" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="detector" Content="◀" Command="{Binding DecreaseDigitalNoiseReductionLevelCommand}" IsEnabled="{Binding CanDecreaseDigitalNoiseReductionLevel}" ToolTip.Tip="{DynamicResource DecreaseDnrTip}" />
                            <Button Classes="detector" Content="▶" Command="{Binding IncreaseDigitalNoiseReductionLevelCommand}" IsEnabled="{Binding CanIncreaseDigitalNoiseReductionLevel}" ToolTip.Tip="{DynamicResource IncreaseDnrTip}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DigitalNoiseReductionLevelReading}" FontSize="14" FontWeight="Bold" MinWidth="30" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="FUNC" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" VerticalAlignment="Center" />
                        <ComboBox Width="150"
                                  ItemsSource="{Binding FuncKnobOptions}"
                                  SelectedItem="{Binding SelectedFuncKnobOption, Mode=TwoWay}"
                                  IsEnabled="{Binding IsConnected}"
                                  Height="32"
                                  MinHeight="32"
                                  FontSize="10"
                                  Padding="8,2"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Classes="panel" Padding="21,18,18,18">
            <Grid ColumnDefinitions="*,*,*,*,Auto,Auto,Auto" ColumnSpacing="20" VerticalAlignment="Center">
                <StackPanel Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource TransmitMetersTitle}" FontSize="13" FontWeight="Bold" Foreground="#D7E1EC" />
                    <TextBlock Text="{DynamicResource ActiveDuringTx}" FontSize="11" Foreground="#98A8A2" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource PowerOutputEstimate}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" />
                    <TextBlock Text="{Binding PowerOutputReading}" FontSize="25" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource SwrEstimate}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" />
                    <TextBlock Text="{Binding SwrReading}" Foreground="{Binding SwrIndicatorBrush}" FontSize="25" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="ALC (0-100%)" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" />
                    <TextBlock Text="{Binding AlcReading}" Foreground="{Binding AlcIndicatorBrush}" FontSize="25" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" IsEnabled="{Binding CanSelectMeterDetector}" VerticalAlignment="Center">
                    <Button Classes="detector" Classes.selected="{Binding IsAverageMeterDetector}" Content="AVG" Command="{Binding SelectAverageMeterDetectorCommand}" />
                    <Button Classes="detector" Classes.selected="{Binding IsPeakMeterDetectorSelected}" Content="PEAK" Command="{Binding SelectPeakMeterDetectorCommand}" />
                </StackPanel>
                <Button Grid.Column="5" Classes="detector tune" Content="ANT TUNE" Command="{Binding StartAntennaTuningCommand}" VerticalAlignment="Center" />
                <Border Grid.Column="6" Classes="transmit-status" Classes.transmitting="{Binding IsTransmitting}" Width="150" BorderThickness="0" CornerRadius="4" Padding="8,9" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TransmitStatusText}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="13.5" MinHeight="288">
            <Border Grid.Column="1" Classes="vfo-frame main-vfo" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource MainVfoBorder}" BorderThickness="1.5" CornerRadius="9" Padding="22.5,19.5,19.5,19.5">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                    <Grid Grid.Column="0" ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Grid Width="24" Height="24">
                                <Path Data="{StaticResource VfoSignalWaves}" Stroke="#A8ED35" StrokeThickness="1.8" StrokeLineCap="Round" />
                                <Ellipse Width="4.5" Height="4.5" Fill="#A8ED35" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="MAIN VFO" FontSize="22" FontWeight="Bold" Foreground="#E9EFF6" VerticalAlignment="Center">
                                <TextBlock.RenderTransform><TranslateTransform Y="-1" /></TextBlock.RenderTransform>
                            </TextBlock>
                            <Grid IsVisible="{Binding MainVfoStateText, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" VerticalAlignment="Center">
                                <Border Background="{Binding MainVfoStateBrush}" BorderBrush="{Binding MainVfoStateBrush}" BorderThickness="1" CornerRadius="4" Opacity="0.3" />
                                <TextBlock Text="{Binding MainVfoStateText}" Foreground="{Binding MainVfoStateBrush}" FontSize="12" FontWeight="Bold" Padding="7,3" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding MainFrequencyDisplay}" FontFamily="Consolas" FontSize="{Binding MainFrequencyFontSize}" FontWeight="Bold" Foreground="{Binding MainFrequencyBrush}" VerticalAlignment="Center" Margin="8,4,8,0" />
                        <Border Grid.Column="2" Background="#000000" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock Text="{Binding MainModulationDisplay}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" RowDefinitions="Auto,12,Auto" RowSpacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SMeterTitle}" FontSize="10" FontWeight="Bold" Foreground="#B6D66C" />
                            <TextBlock Grid.Column="1" Text="{Binding SMeterReading}" FontSize="10" FontWeight="Bold" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="125*,130*" ColumnSpacing="1">
                            <ProgressBar Value="{Binding SMeterSRangeValue}" Maximum="125" Foreground="#FFFFFF" Background="#263132" />
                            <ProgressBar Grid.Column="1" Value="{Binding SMeterOverRangeValue}" Maximum="130" Foreground="#328ACB" Background="#263132" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="125*,47*,48*,35*">
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*">
                                <TextBlock Classes="s-meter-scale" Text="S0" HorizontalAlignment="Left" />
                                <TextBlock Classes="s-meter-scale" Text="S1" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="1" Classes="s-meter-scale" Text="S2" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Classes="s-meter-scale" Text="S3" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Classes="s-meter-scale" Text="S4" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Classes="s-meter-scale" Text="S5" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Classes="s-meter-scale" Text="S6" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Classes="s-meter-scale" Text="S7" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Classes="s-meter-scale" Text="S8" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="8" Classes="s-meter-scale" Text="S9" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Grid.Column="1" Classes="s-meter-scale" Text="+20" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Classes="s-meter-scale" Text="+40" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Classes="s-meter-scale" Text="+60" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Height="1" Background="#303B3C" />
                    <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" VerticalAlignment="Stretch">
                        <StackPanel Grid.Row="0" Grid.Column="0" IsEnabled="{Binding IsConnected}" VerticalAlignment="Top">
                            <TextBlock Text="{DynamicResource MeterSelection}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" Margin="4,0,0,5" />
                            <ItemsControl ItemsSource="{Binding MainMeters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MeterOptionViewModel">
                                        <ToggleButton Classes="meter" Content="{Binding Label}" IsChecked="{Binding IsSelected}" Command="{Binding SelectCommand}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource PinnedFrequencies}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" Margin="4,14,0,6" />
                            <Grid ColumnDefinitions="Auto,*">
                                <Button Classes="pinned-frequency pin" Content="{DynamicResource PinFrequency}" Command="{Binding PinMainFrequencyCommand}" IsEnabled="{Binding CanPinMainFrequency}" VerticalAlignment="Top" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding MainPinnedFrequencies}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PinnedFrequencyViewModel">
                                            <Button Classes="pinned-frequency" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding Tooltip}" Command="{Binding SelectCommand}" PointerPressed="OnPinnedFrequencyPointerPressed">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding ModeDisplay}" FontSize="11" TextAlignment="Center" HorizontalAlignment="Center" />
                                                    <TextBox Classes="pinned-frequency-callsign" Text="{Binding CallSign, Mode=TwoWay}"
                                                             PlaceholderText="{DynamicResource CallSignPlaceholder}" FontFamily="Consolas" FontSize="12" TextAlignment="Center"
                                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                             Width="56" Height="20" Padding="1,0"
                                                             TextChanged="OnPinnedCallSignTextChanged" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                        <Border x:Name="MainVolumeTrack" Grid.Row="0" Grid.Column="1" Width="14" Margin="0,10" Background="#263132" CornerRadius="7" SizeChanged="OnVolumeTrackSizeChanged" PointerPressed="OnMainVolumePointerPressed" PointerWheelChanged="OnMainVolumeWheelChanged">
                            <Border x:Name="MainVolumeFill" Height="0" VerticalAlignment="Bottom" Background="#FFFFFF" CornerRadius="7" />
                        </Border>
                        <Button Grid.Row="1" Grid.Column="1" Classes="volume-mute" Width="24" Height="24" IsEnabled="{Binding IsConnected}" Command="{Binding ToggleMainVolumeMuteCommand}" ToolTip.Tip="{DynamicResource MuteMainVolumeTip}">
                            <Grid Width="14" Height="14">
                                <Path Data="M2,6 L5,6 L10,2 L10,12 L5,8 L2,8 Z" Fill="#E9EFED" />
                                <Path Data="M11,5 Q14,7 11,9" Stroke="#E9EFED" StrokeThickness="1.5" />
                                <Path Data="M3,3 L13,13" Stroke="#E53935" StrokeThickness="1.5" IsVisible="{Binding IsMainVolumeMuted}" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Classes="vfo-frame" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource SubVfoBorder}" BorderThickness="1.5" CornerRadius="9" Padding="22.5,19.5,19.5,19.5">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                    <Grid Grid.Column="0" ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Grid Width="24" Height="24">
                                <Path Data="{StaticResource VfoSignalWaves}" Stroke="#00DDF5" StrokeThickness="1.8" StrokeLineCap="Round" />
                                <Ellipse Width="4.5" Height="4.5" Fill="#00DDF5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="SUB VFO" FontSize="22" FontWeight="Bold" Foreground="#E9EFF6" VerticalAlignment="Center">
                                <TextBlock.RenderTransform><TranslateTransform Y="-1" /></TextBlock.RenderTransform>
                            </TextBlock>
                            <Grid IsVisible="{Binding SubVfoStateText, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" VerticalAlignment="Center">
                                <Border Background="{Binding SubVfoStateBrush}" BorderBrush="{Binding SubVfoStateBrush}" BorderThickness="1" CornerRadius="4" Opacity="0.3" />
                                <TextBlock Text="{Binding SubVfoStateText}" Foreground="{Binding SubVfoStateBrush}" FontSize="12" FontWeight="Bold" Padding="7,3" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SubFrequencyDisplay}" FontFamily="Consolas" FontSize="{Binding SubFrequencyFontSize}" FontWeight="Bold" Foreground="{Binding SubFrequencyBrush}" VerticalAlignment="Center" Margin="8,4,8,0" />
                        <Border Grid.Column="2" Background="#000000" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock Text="{Binding SubModulationDisplay}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" RowDefinitions="Auto,12,Auto" RowSpacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SMeterTitle}" FontSize="10" FontWeight="Bold" Foreground="#79C6CF" />
                            <TextBlock Grid.Column="1" Text="{Binding SubSMeterReading}" FontSize="10" FontWeight="Bold" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="125*,130*" ColumnSpacing="1">
                            <ProgressBar Value="{Binding SubSMeterSRangeValue}" Maximum="125" Foreground="#FFFFFF" Background="#263132" />
                            <ProgressBar Grid.Column="1" Value="{Binding SubSMeterOverRangeValue}" Maximum="130" Foreground="#328ACB" Background="#263132" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="125*,47*,48*,35*">
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*">
                                <TextBlock Classes="s-meter-scale" Text="S0" HorizontalAlignment="Left" />
                                <TextBlock Classes="s-meter-scale" Text="S1" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="1" Classes="s-meter-scale" Text="S2" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Classes="s-meter-scale" Text="S3" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Classes="s-meter-scale" Text="S4" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Classes="s-meter-scale" Text="S5" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Classes="s-meter-scale" Text="S6" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Classes="s-meter-scale" Text="S7" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Classes="s-meter-scale" Text="S8" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="8" Classes="s-meter-scale" Text="S9" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Grid.Column="1" Classes="s-meter-scale" Text="+20" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Classes="s-meter-scale" Text="+40" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Classes="s-meter-scale" Text="+60" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Height="1" Background="#303B3C" />
                    <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" VerticalAlignment="Stretch">
                        <StackPanel Grid.Row="0" Grid.Column="0" IsEnabled="{Binding IsConnected}" VerticalAlignment="Top">
                            <TextBlock Text="{DynamicResource MeterSelection}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" Margin="4,0,0,5" />
                            <ItemsControl ItemsSource="{Binding SubMeters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MeterOptionViewModel">
                                        <ToggleButton Classes="meter" Content="{Binding Label}" IsChecked="{Binding IsSelected}" Command="{Binding SelectCommand}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource PinnedFrequencies}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" Margin="4,14,0,6" />
                            <Grid ColumnDefinitions="Auto,*">
                                <Button Classes="pinned-frequency pin" Content="{DynamicResource PinFrequency}" Command="{Binding PinSubFrequencyCommand}" IsEnabled="{Binding CanPinSubFrequency}" VerticalAlignment="Top" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding SubPinnedFrequencies}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PinnedFrequencyViewModel">
                                            <Button Classes="pinned-frequency" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding Tooltip}" Command="{Binding SelectCommand}" PointerPressed="OnPinnedFrequencyPointerPressed">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding ModeDisplay}" FontSize="11" TextAlignment="Center" HorizontalAlignment="Center" />
                                                    <TextBox Classes="pinned-frequency-callsign" Text="{Binding CallSign, Mode=TwoWay}"
                                                             PlaceholderText="{DynamicResource CallSignPlaceholder}" FontFamily="Consolas" FontSize="12" TextAlignment="Center"
                                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                             Width="56" Height="20" Padding="1,0"
                                                             TextChanged="OnPinnedCallSignTextChanged" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                        <Border x:Name="SubVolumeTrack" Grid.Row="0" Grid.Column="1" Width="14" Margin="0,10" Background="#263132" CornerRadius="7" SizeChanged="OnVolumeTrackSizeChanged" PointerPressed="OnSubVolumePointerPressed" PointerWheelChanged="OnSubVolumeWheelChanged">
                            <Border x:Name="SubVolumeFill" Height="0" VerticalAlignment="Bottom" Background="#FFFFFF" CornerRadius="7" />
                        </Border>
                        <Button Grid.Row="1" Grid.Column="1" Classes="volume-mute" Width="24" Height="24" IsEnabled="{Binding IsConnected}" Command="{Binding ToggleSubVolumeMuteCommand}" ToolTip.Tip="{DynamicResource MuteSubVolumeTip}">
                            <Grid Width="14" Height="14">
                                <Path Data="M2,6 L5,6 L10,2 L10,12 L5,8 L2,8 Z" Fill="#E9EFED" />
                                <Path Data="M11,5 Q14,7 11,9" Stroke="#E9EFED" StrokeThickness="1.5" />
                                <Path Data="M3,3 L13,13" Stroke="#E53935" StrokeThickness="1.5" IsVisible="{Binding IsSubVolumeMuted}" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <Border Classes="vfo-glow" Classes.transmitting="{Binding IsSubVfoTransmitting}"
                    Background="Transparent" CornerRadius="9"
                    IsHitTestVisible="False">
                <Grid>
                    <Border Background="Transparent" CornerRadius="9" BoxShadow="inset 0 -5 14 1 #5000E6FF" OpacityMask="{StaticResource VfoBottomGlowMask}" />
                    <Border Classes="vfo-corner-glow" Background="{StaticResource SubVfoCornerGlow}" CornerRadius="9" />
                    <Border Classes="vfo-corner-horizontal" BorderBrush="#45FFFF" BorderThickness="1.5,1.5,0,0" CornerRadius="9" />
                    <Border Classes="vfo-corner-vertical" BorderBrush="#45FFFF" BorderThickness="1.5,1.5,0,0" CornerRadius="9" />
                    <Border Classes="vfo-top-right" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Classes="vfo-glow" Classes.transmitting="{Binding IsMainVfoTransmitting}"
                    Background="Transparent" CornerRadius="9"
                    IsHitTestVisible="False">
                <Grid>
                    <Border Background="Transparent" CornerRadius="9" BoxShadow="inset 0 -5 14 1 #50B7FA24" OpacityMask="{StaticResource VfoBottomGlowMask}" />
                    <Border Classes="vfo-corner-glow" Background="{StaticResource MainVfoCornerGlow}" CornerRadius="9" />
                    <Border Classes="vfo-corner-horizontal" BorderBrush="#E4FF52" BorderThickness="1.5,1.5,0,0" CornerRadius="9" />
                    <Border Classes="vfo-corner-vertical" BorderBrush="#E4FF52" BorderThickness="1.5,1.5,0,0" CornerRadius="9" />
                    <Border Classes="vfo-top-right" />
                </Grid>
            </Border>
            <Border Classes="vfo-transmit-overlay" Classes.transmitting="{Binding IsSubVfoTransmitting}"
                    Background="Transparent" BorderBrush="{StaticResource TransmitVfoBorder}" BorderThickness="1.5" CornerRadius="9"
                    IsHitTestVisible="False">
                <Grid>
                    <Border Background="Transparent" CornerRadius="8" BoxShadow="inset 0 -5 14 1 #58FF5049" OpacityMask="{StaticResource VfoBottomGlowMask}" />
                    <Border Classes="vfo-corner-glow" Background="{StaticResource TransmitVfoCornerGlow}" CornerRadius="8" />
                    <Border Classes="vfo-corner-horizontal" BorderBrush="#FF6058" BorderThickness="1.5,1.5,0,0" CornerRadius="8" />
                    <Border Classes="vfo-corner-vertical" BorderBrush="#FF6058" BorderThickness="1.5,1.5,0,0" CornerRadius="8" />
                    <Border Classes="vfo-top-right" CornerRadius="8" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Classes="vfo-transmit-overlay" Classes.transmitting="{Binding IsMainVfoTransmitting}"
                    Background="Transparent" BorderBrush="{StaticResource TransmitVfoBorder}" BorderThickness="1.5" CornerRadius="9"
                    IsHitTestVisible="False">
                <Grid>
                    <Border Background="Transparent" CornerRadius="8" BoxShadow="inset 0 -5 14 1 #58FF5049" OpacityMask="{StaticResource VfoBottomGlowMask}" />
                    <Border Classes="vfo-corner-glow" Background="{StaticResource TransmitVfoCornerGlow}" CornerRadius="8" />
                    <Border Classes="vfo-corner-horizontal" BorderBrush="#FF6058" BorderThickness="1.5,1.5,0,0" CornerRadius="8" />
                    <Border Classes="vfo-corner-vertical" BorderBrush="#FF6058" BorderThickness="1.5,1.5,0,0" CornerRadius="8" />
                    <Border Classes="vfo-top-right" CornerRadius="8" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
    </ScrollViewer>
    <Border Grid.Row="1" Background="#0CFFFFFF" BorderBrush="#34434F" BorderThickness="0,1,0,0" Padding="22.5,8">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding BuildInfo}" FontSize="10" Foreground="#98A8A2" VerticalAlignment="Center" />
            <Canvas Grid.Column="1" Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                <Ellipse Canvas.Left="-25" Canvas.Top="-8" Width="15" Height="15" Stroke="#CBD6E2" StrokeThickness="1.5" />
                <Path Canvas.Left="-25" Canvas.Top="-8" Data="M7.5,3.5 L7.5,8 L10.5,10" Stroke="#CBD6E2" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" />
            </Canvas>
            <TextBlock x:Name="ClockText" Grid.Column="1" FontFamily="Consolas" FontSize="21"
                       Margin="0,-8,0,-8" VerticalAlignment="Center">
                <TextBlock.RenderTransform>
                    <TranslateTransform Y="2" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </Border>
    </Grid>
    </Grid>

</Window>
