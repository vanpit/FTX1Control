<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FTX1Control.ViewModels"
        xmlns:models="using:FTX1Control.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1156" d:DesignHeight="1010"
        x:Class="FTX1Control.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Topmost="{Binding IsAlwaysOnTop}"
        Width="1156" Height="1010" MinWidth="1000" MinHeight="1010" WindowStartupLocation="Manual"
        Background="#080D0E"
        Icon="/Assets/ftx1-radio.ico"
        Title="{DynamicResource WindowTitle}">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="Foreground" Value="#E9EFED" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#20292A" />
            <Setter Property="Foreground" Value="#F0F4F2" />
            <Setter Property="BorderBrush" Value="#3B4948" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#20292A" />
            <Setter Property="Foreground" Value="#F0F4F2" />
            <Setter Property="BorderBrush" Value="#3B4948" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="Button.connect">
            <Setter Property="Background" Value="#D59A42" />
            <Setter Property="Foreground" Value="#171B19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.volume-mute">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.meter">
            <Setter Property="Background" Value="#20292A" />
            <Setter Property="Foreground" Value="#D5DEDA" />
            <Setter Property="BorderBrush" Value="#3B4948" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ToggleButton.meter:checked">
            <Setter Property="Background" Value="#B6D66C" />
            <Setter Property="Foreground" Value="#172018" />
            <Setter Property="BorderBrush" Value="#B6D66C" />
        </Style>
        <Style Selector="ToggleButton.meter:pointerover">
            <Setter Property="BorderBrush" Value="#D59A42" />
        </Style>
        <Style Selector="Button.detector">
            <Setter Property="Background" Value="#20292A" />
            <Setter Property="Foreground" Value="#D5DEDA" />
            <Setter Property="BorderBrush" Value="#3B4948" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.detector.selected">
            <Setter Property="Background" Value="#B6D66C" />
            <Setter Property="Foreground" Value="#172018" />
            <Setter Property="BorderBrush" Value="#B6D66C" />
        </Style>
        <Style Selector="Button.detector.rf-power">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,9" />
        </Style>
        <Style Selector="Button.detector.tune:not(:disabled)">
            <Setter Property="Background" Value="#D59A42" />
            <Setter Property="Foreground" Value="#171B19" />
            <Setter Property="BorderBrush" Value="#D59A42" />
        </Style>
        <Style Selector="Button.connect:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, Button.detector.tune:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EFB665" />
            <Setter Property="Foreground" Value="#171B19" />
            <Setter Property="BorderBrush" Value="#EFB665" />
        </Style>
        <Style Selector="Button.pinned-frequency">
            <Setter Property="Background" Value="#20292A" />
            <Setter Property="Foreground" Value="#D5DEDA" />
            <Setter Property="BorderBrush" Value="#3B4948" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Height" Value="70" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.pinned-frequency.pin">
            <Setter Property="Background" Value="#B6D66C" />
            <Setter Property="Foreground" Value="#172018" />
            <Setter Property="BorderBrush" Value="#B6D66C" />
        </Style>
        <Style Selector="Button.pinned-frequency.pin /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.pinned-frequency-callsign">
            <Setter Property="Background" Value="#151D1E" />
            <Setter Property="Foreground" Value="#F0F4F2" />
            <Setter Property="BorderBrush" Value="#3B4948" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.pinned-frequency.selected, Button.detector.rf-power-selected">
            <Setter Property="Background" Value="#328ACB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#328ACB" />
        </Style>
        <Style Selector="Button.pinned-frequency:pointerover">
            <Setter Property="BorderBrush" Value="#D59A42" />
        </Style>
        <Style Selector="Button.detector.selected:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, Button.pinned-frequency.pin:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#CDEB85" />
            <Setter Property="Foreground" Value="#172018" />
            <Setter Property="BorderBrush" Value="#CDEB85" />
        </Style>
        <Style Selector="ToggleButton.auto-scroll">
            <Setter Property="Background" Value="#20292A" />
            <Setter Property="Foreground" Value="#D5DEDA" />
            <Setter Property="BorderBrush" Value="#3B4948" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="ToggleButton.auto-scroll:checked">
            <Setter Property="Background" Value="#28352D" />
            <Setter Property="Foreground" Value="#B6D66C" />
            <Setter Property="BorderBrush" Value="#B6D66C" />
        </Style>
        <Style Selector="ToggleButton.always-on-top">
            <Setter Property="Background" Value="#20292A" />
            <Setter Property="Foreground" Value="#D5DEDA" />
            <Setter Property="BorderBrush" Value="#3B4948" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Height" Value="44" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ToggleButton.always-on-top:checked">
            <Setter Property="Background" Value="#28352D" />
            <Setter Property="Foreground" Value="#B6D66C" />
            <Setter Property="BorderBrush" Value="#B6D66C" />
        </Style>
        <Style Selector="ToggleButton.meter:checked:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.auto-scroll:checked:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.always-on-top:checked:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, Button.pinned-frequency.selected:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, Button.detector.rf-power-selected:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#489CDA" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#489CDA" />
        </Style>
        <Style Selector="Border.transmit-status">
            <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundChecked}" />
        </Style>
        <Style Selector="Border.transmit-status.transmitting">
            <Setter Property="Background" Value="{Binding TransmitStatusBrush}" />
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Background" Value="#E53935" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Background" Value="#851B19" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="TextBlock.s-meter-scale">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#98A8A2" />
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="22.5,24" RowSpacing="18">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" VerticalAlignment="Center" Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource HeaderEyebrow}" FontSize="12" FontWeight="Bold" Foreground="#B6D66C" />
            <TextBlock Grid.Row="1" Text="{DynamicResource HeaderTitle}" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="{Binding BuildInfo}" FontSize="10" Foreground="#98A8A2" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox Width="140" Height="44" SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}" VerticalAlignment="Center">
                    <ComboBoxItem Content="Polski" />
                    <ComboBoxItem Content="English" />
                </ComboBox>
                <ToggleButton Classes="always-on-top"
                              Content="{DynamicResource AlwaysOnTop}"
                              IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                <Border Height="44" Background="#20292A" BorderBrush="#3B4948" BorderThickness="1" CornerRadius="4" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding ConnectionIndicatorBrush}" />
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <Image Grid.RowSpan="2" Grid.Column="2" Source="/Assets/SQ8MSX_round_logo_QRZ.png" Width="96" Height="96" Margin="18,0,0,0" Stretch="Uniform" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="13.5">
            <Border Background="#151D20" BorderBrush="#D59A42" BorderThickness="4,1,1,1" CornerRadius="5" Padding="18">
                <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                        <TextBlock Text="{DynamicResource SerialPortLabel}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" />
                        <ComboBox ItemsSource="{Binding AvailableComPorts}" SelectedItem="{Binding SelectedComPort}" IsEnabled="{Binding CanSelectComPort}" DropDownOpened="OnComPortDropDownOpened" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ComPortOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Stretch">
                        <TextBlock Text="{DynamicResource BaudRateLabel}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" />
                        <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate}" IsEnabled="{Binding CanSelectBaudRate}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="connect" Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectionCommand}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="#151D20" BorderBrush="#D59A42" BorderThickness="4,1,1,1" CornerRadius="5" Padding="14,11">
                <Grid RowDefinitions="Auto,Auto,56" RowSpacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{DynamicResource CatStatus}" FontSize="10" FontWeight="Bold" Foreground="#D59A42" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12" Foreground="#C3CECA" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ToggleButton Grid.Column="2" Classes="auto-scroll" IsChecked="{Binding IsCatLogAutoScroll}" Content="{Binding CatLogAutoScrollButtonText}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding CatLogFileError}" IsVisible="{Binding HasCatLogFileError}" FontSize="12" Foreground="#E74C3C" TextWrapping="Wrap" />
                    <ScrollViewer x:Name="CatLogScrollViewer" Grid.Row="2" Background="#000000" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <SelectableTextBlock x:Name="CatLogText" Text="{Binding CatLog}" Margin="12,0" TextWrapping="NoWrap" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="11" LineHeight="14" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#151D20" BorderBrush="#328ACB" BorderThickness="4,1,1,1" CornerRadius="5" Padding="18">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="{DynamicResource TransmitPowerTitle}" FontSize="13" FontWeight="Bold" Foreground="#B6D66C" />
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower5Selected}" Margin="0,0,6,0" Content="5 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="5" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower10Selected}" Margin="0,0,6,0" Content="10 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="10" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower15Selected}" Margin="0,0,6,0" Content="15 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="15" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower20Selected}" Margin="0,0,6,0" Content="20 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="20" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower25Selected}" Margin="0,0,6,0" Content="25 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="25" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower30Selected}" Margin="0,0,6,0" Content="30 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="30" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower50Selected}" Margin="0,0,6,0" Content="50 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="50" />
                        <Button Classes="detector rf-power" Classes.rf-power-selected="{Binding IsRfPower100Selected}" Content="100 W" Command="{Binding SelectRfPowerPresetCommand}" CommandParameter="100" />
                    </StackPanel>
                    <Slider Grid.Column="1" Minimum="5" Maximum="{Binding MaximumRfPower}" Value="{Binding RfPowerSliderValue, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1"
                            IsEnabled="{Binding CanSetRfPower}" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            PointerReleased="OnRfPowerSliderPointerReleased" KeyUp="OnRfPowerSliderKeyUp" />
                    <TextBlock Grid.Column="2" Text="{Binding RfPowerReading}" FontSize="25" FontWeight="Bold" MinWidth="90" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Grid.Row="2" Text="{DynamicResource SettingsTitle}" FontSize="13" FontWeight="Bold" Foreground="#B6D66C" Margin="0,8,0,0" />
                <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="32">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="D-LEVEL" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="detector" Content="◀" Command="{Binding DecreaseDLevelCommand}" IsEnabled="{Binding CanDecreaseDLevel}" ToolTip.Tip="{DynamicResource DecreaseDLevelTip}" />
                            <Button Classes="detector" Content="▶" Command="{Binding IncreaseDLevelCommand}" IsEnabled="{Binding CanIncreaseDLevel}" ToolTip.Tip="{DynamicResource IncreaseDLevelTip}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DLevelReading}" FontSize="14" FontWeight="Bold" MinWidth="75" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="NB" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="detector" Content="◀" Command="{Binding DecreaseNoiseBlankerLevelCommand}" IsEnabled="{Binding CanDecreaseNoiseBlankerLevel}" ToolTip.Tip="{DynamicResource DecreaseNbTip}" />
                            <Button Classes="detector" Content="▶" Command="{Binding IncreaseNoiseBlankerLevelCommand}" IsEnabled="{Binding CanIncreaseNoiseBlankerLevel}" ToolTip.Tip="{DynamicResource IncreaseNbTip}" />
                        </StackPanel>
                        <TextBlock Text="{Binding NoiseBlankerLevelReading}" FontSize="14" FontWeight="Bold" MinWidth="30" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="DNR" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="detector" Content="◀" Command="{Binding DecreaseDigitalNoiseReductionLevelCommand}" IsEnabled="{Binding CanDecreaseDigitalNoiseReductionLevel}" ToolTip.Tip="{DynamicResource DecreaseDnrTip}" />
                            <Button Classes="detector" Content="▶" Command="{Binding IncreaseDigitalNoiseReductionLevelCommand}" IsEnabled="{Binding CanIncreaseDigitalNoiseReductionLevel}" ToolTip.Tip="{DynamicResource IncreaseDnrTip}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DigitalNoiseReductionLevelReading}" FontSize="14" FontWeight="Bold" MinWidth="30" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="FUNC" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" VerticalAlignment="Center" />
                        <ComboBox Width="150"
                                  ItemsSource="{Binding FuncKnobOptions}"
                                  SelectedItem="{Binding SelectedFuncKnobOption, Mode=TwoWay}"
                                  IsEnabled="{Binding IsConnected}"
                                  Height="32"
                                  MinHeight="32"
                                  FontSize="10"
                                  Padding="8,2"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#151D20" BorderBrush="#E53935" BorderThickness="4,1,1,1" CornerRadius="5" Padding="18">
            <Grid ColumnDefinitions="*,*,*,*,Auto,Auto,Auto" ColumnSpacing="20" VerticalAlignment="Center">
                <StackPanel Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource TransmitMetersTitle}" FontSize="13" FontWeight="Bold" Foreground="#B6D66C" />
                    <TextBlock Text="{DynamicResource ActiveDuringTx}" FontSize="11" Foreground="#98A8A2" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource PowerOutputEstimate}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" />
                    <TextBlock Text="{Binding PowerOutputReading}" FontSize="25" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource SwrEstimate}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" />
                    <TextBlock Text="{Binding SwrReading}" Foreground="{Binding SwrIndicatorBrush}" FontSize="25" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="ALC (0-100%)" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" />
                    <TextBlock Text="{Binding AlcReading}" Foreground="{Binding AlcIndicatorBrush}" FontSize="25" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" IsEnabled="{Binding CanSelectMeterDetector}" VerticalAlignment="Center">
                    <Button Classes="detector" Classes.selected="{Binding IsAverageMeterDetector}" Content="AVG" Command="{Binding SelectAverageMeterDetectorCommand}" />
                    <Button Classes="detector" Classes.selected="{Binding IsPeakMeterDetectorSelected}" Content="PEAK" Command="{Binding SelectPeakMeterDetectorCommand}" />
                </StackPanel>
                <Button Grid.Column="5" Classes="detector tune" Content="ANT TUNE" Command="{Binding StartAntennaTuningCommand}" VerticalAlignment="Center" />
                <Border Grid.Column="6" Classes="transmit-status" Classes.transmitting="{Binding IsTransmitting}" Width="150" BorderThickness="0" CornerRadius="4" Padding="8,9" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TransmitStatusText}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="13.5" MinHeight="288">
            <Border Grid.Column="1" Background="#151D20" BorderBrush="#B6D66C" BorderThickness="4,1,1,1" CornerRadius="5" Padding="20">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                    <Grid Grid.Column="0" ColumnDefinitions="*,Auto,Auto">
                        <Border Background="#28352D" CornerRadius="3" Padding="8,5" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="MAIN VFO" FontSize="22" FontWeight="Bold" Foreground="#B6D66C" />
                                <TextBlock Text="{Binding MainVfoStateText}" Foreground="{Binding MainVfoStateBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding MainFrequencyDisplay}" FontFamily="Consolas" FontSize="{Binding MainFrequencyFontSize}" FontWeight="Bold" Foreground="{Binding MainFrequencyBrush}" VerticalAlignment="Center" Margin="8,4,8,0" />
                        <Border Grid.Column="2" Background="#000000" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock Text="{Binding MainModulationDisplay}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" RowDefinitions="Auto,12,Auto" RowSpacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SMeterTitle}" FontSize="10" FontWeight="Bold" Foreground="#B6D66C" />
                            <TextBlock Grid.Column="1" Text="{Binding SMeterReading}" FontSize="10" FontWeight="Bold" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="125*,130*" ColumnSpacing="1">
                            <ProgressBar Value="{Binding SMeterSRangeValue}" Maximum="125" Foreground="#FFFFFF" Background="#263132" />
                            <ProgressBar Grid.Column="1" Value="{Binding SMeterOverRangeValue}" Maximum="130" Foreground="#328ACB" Background="#263132" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="125*,47*,48*,35*">
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*">
                                <TextBlock Classes="s-meter-scale" Text="S0" HorizontalAlignment="Left" />
                                <TextBlock Classes="s-meter-scale" Text="S1" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="1" Classes="s-meter-scale" Text="S2" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Classes="s-meter-scale" Text="S3" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Classes="s-meter-scale" Text="S4" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Classes="s-meter-scale" Text="S5" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Classes="s-meter-scale" Text="S6" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Classes="s-meter-scale" Text="S7" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Classes="s-meter-scale" Text="S8" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="8" Classes="s-meter-scale" Text="S9" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Grid.Column="1" Classes="s-meter-scale" Text="+20" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Classes="s-meter-scale" Text="+40" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Classes="s-meter-scale" Text="+60" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Height="1" Background="#303B3C" />
                    <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" VerticalAlignment="Stretch">
                        <StackPanel Grid.Row="0" Grid.Column="0" IsEnabled="{Binding IsConnected}" VerticalAlignment="Top">
                            <TextBlock Text="{DynamicResource MeterSelection}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" Margin="4,0,0,5" />
                            <ItemsControl ItemsSource="{Binding MainMeters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MeterOptionViewModel">
                                        <ToggleButton Classes="meter" Content="{Binding Label}" IsChecked="{Binding IsSelected}" Command="{Binding SelectCommand}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource PinnedFrequencies}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" Margin="4,14,0,6" />
                            <Grid ColumnDefinitions="Auto,*">
                                <Button Classes="pinned-frequency pin" Content="{DynamicResource PinFrequency}" Command="{Binding PinMainFrequencyCommand}" IsEnabled="{Binding CanPinMainFrequency}" VerticalAlignment="Top" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding MainPinnedFrequencies}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PinnedFrequencyViewModel">
                                            <Button Classes="pinned-frequency" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding Tooltip}" Command="{Binding SelectCommand}" PointerPressed="OnPinnedFrequencyPointerPressed">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding ModeDisplay}" FontSize="11" TextAlignment="Center" HorizontalAlignment="Center" />
                                                    <TextBox Classes="pinned-frequency-callsign" Text="{Binding CallSign, Mode=TwoWay}"
                                                             PlaceholderText="{DynamicResource CallSignPlaceholder}" FontFamily="Consolas" FontSize="12" TextAlignment="Center"
                                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                             Width="56" Height="20" Padding="1,0"
                                                             TextChanged="OnPinnedCallSignTextChanged" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                        <Border x:Name="MainVolumeTrack" Grid.Row="0" Grid.Column="1" Width="14" Margin="0,10" Background="#263132" CornerRadius="2" PointerPressed="OnMainVolumePointerPressed" PointerWheelChanged="OnMainVolumeWheelChanged">
                            <Border x:Name="MainVolumeFill" Background="#FFFFFF" RenderTransformOrigin="50%,100%">
                                <Border.RenderTransform><ScaleTransform ScaleY="0" /></Border.RenderTransform>
                            </Border>
                        </Border>
                        <Button Grid.Row="1" Grid.Column="1" Classes="volume-mute" Width="24" Height="24" IsEnabled="{Binding IsConnected}" Command="{Binding ToggleMainVolumeMuteCommand}" ToolTip.Tip="{DynamicResource MuteMainVolumeTip}">
                            <Grid Width="14" Height="14">
                                <Path Data="M2,6 L5,6 L10,2 L10,12 L5,8 L2,8 Z" Fill="#E9EFED" />
                                <Path Data="M11,5 Q14,7 11,9" Stroke="#E9EFED" StrokeThickness="1.5" />
                                <Path Data="M3,3 L13,13" Stroke="#E53935" StrokeThickness="1.5" IsVisible="{Binding IsMainVolumeMuted}" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Background="#151D20" BorderBrush="#79C6CF" BorderThickness="4,1,1,1" CornerRadius="5" Padding="20">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                    <Grid Grid.Column="0" ColumnDefinitions="*,Auto,Auto">
                        <Border Background="#25343A" CornerRadius="3" Padding="8,5" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="SUB VFO" FontSize="22" FontWeight="Bold" Foreground="#79C6CF" />
                                <TextBlock Text="{Binding SubVfoStateText}" Foreground="{Binding SubVfoStateBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding SubFrequencyDisplay}" FontFamily="Consolas" FontSize="{Binding SubFrequencyFontSize}" FontWeight="Bold" Foreground="{Binding SubFrequencyBrush}" VerticalAlignment="Center" Margin="8,4,8,0" />
                        <Border Grid.Column="2" Background="#000000" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock Text="{Binding SubModulationDisplay}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" RowDefinitions="Auto,12,Auto" RowSpacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SMeterTitle}" FontSize="10" FontWeight="Bold" Foreground="#79C6CF" />
                            <TextBlock Grid.Column="1" Text="{Binding SubSMeterReading}" FontSize="10" FontWeight="Bold" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="125*,130*" ColumnSpacing="1">
                            <ProgressBar Value="{Binding SubSMeterSRangeValue}" Maximum="125" Foreground="#FFFFFF" Background="#263132" />
                            <ProgressBar Grid.Column="1" Value="{Binding SubSMeterOverRangeValue}" Maximum="130" Foreground="#328ACB" Background="#263132" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="125*,47*,48*,35*">
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*">
                                <TextBlock Classes="s-meter-scale" Text="S0" HorizontalAlignment="Left" />
                                <TextBlock Classes="s-meter-scale" Text="S1" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="1" Classes="s-meter-scale" Text="S2" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Classes="s-meter-scale" Text="S3" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Classes="s-meter-scale" Text="S4" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Classes="s-meter-scale" Text="S5" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Classes="s-meter-scale" Text="S6" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Classes="s-meter-scale" Text="S7" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Classes="s-meter-scale" Text="S8" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="8" Classes="s-meter-scale" Text="S9" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Grid.Column="1" Classes="s-meter-scale" Text="+20" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Classes="s-meter-scale" Text="+40" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Classes="s-meter-scale" Text="+60" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Height="1" Background="#303B3C" />
                    <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" VerticalAlignment="Stretch">
                        <StackPanel Grid.Row="0" Grid.Column="0" IsEnabled="{Binding IsConnected}" VerticalAlignment="Top">
                            <TextBlock Text="{DynamicResource MeterSelection}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" Margin="4,0,0,5" />
                            <ItemsControl ItemsSource="{Binding SubMeters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MeterOptionViewModel">
                                        <ToggleButton Classes="meter" Content="{Binding Label}" IsChecked="{Binding IsSelected}" Command="{Binding SelectCommand}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource PinnedFrequencies}" FontSize="10" FontWeight="Bold" Foreground="#98A8A2" Margin="4,14,0,6" />
                            <Grid ColumnDefinitions="Auto,*">
                                <Button Classes="pinned-frequency pin" Content="{DynamicResource PinFrequency}" Command="{Binding PinSubFrequencyCommand}" IsEnabled="{Binding CanPinSubFrequency}" VerticalAlignment="Top" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding SubPinnedFrequencies}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PinnedFrequencyViewModel">
                                            <Button Classes="pinned-frequency" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding Tooltip}" Command="{Binding SelectCommand}" PointerPressed="OnPinnedFrequencyPointerPressed">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding ModeDisplay}" FontSize="11" TextAlignment="Center" HorizontalAlignment="Center" />
                                                    <TextBox Classes="pinned-frequency-callsign" Text="{Binding CallSign, Mode=TwoWay}"
                                                             PlaceholderText="{DynamicResource CallSignPlaceholder}" FontFamily="Consolas" FontSize="12" TextAlignment="Center"
                                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                             Width="56" Height="20" Padding="1,0"
                                                             TextChanged="OnPinnedCallSignTextChanged" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                        <Border x:Name="SubVolumeTrack" Grid.Row="0" Grid.Column="1" Width="14" Margin="0,10" Background="#263132" CornerRadius="2" PointerPressed="OnSubVolumePointerPressed" PointerWheelChanged="OnSubVolumeWheelChanged">
                            <Border x:Name="SubVolumeFill" Background="#FFFFFF" RenderTransformOrigin="50%,100%">
                                <Border.RenderTransform><ScaleTransform ScaleY="0" /></Border.RenderTransform>
                            </Border>
                        </Border>
                        <Button Grid.Row="1" Grid.Column="1" Classes="volume-mute" Width="24" Height="24" IsEnabled="{Binding IsConnected}" Command="{Binding ToggleSubVolumeMuteCommand}" ToolTip.Tip="{DynamicResource MuteSubVolumeTip}">
                            <Grid Width="14" Height="14">
                                <Path Data="M2,6 L5,6 L10,2 L10,12 L5,8 L2,8 Z" Fill="#E9EFED" />
                                <Path Data="M11,5 Q14,7 11,9" Stroke="#E9EFED" StrokeThickness="1.5" />
                                <Path Data="M3,3 L13,13" Stroke="#E53935" StrokeThickness="1.5" IsVisible="{Binding IsSubVolumeMuted}" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
    </ScrollViewer>

</Window>
